<ld:LDWindow
    x:Class="GeoCadWpf.Views.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:GeoCadWpf.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ld="clr-namespace:LegendDesignWpf.Controls;assembly=LegendDesignWpf"
    xmlns:local="clr-namespace:GeoCadWpf"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mvvm="clr-namespace:GeoCadWpf.MVVM"
    Title="MainWindow"
    Width="1280"
    Height="720"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="55" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <StackPanel Margin="0,8,0,0">

                <controls:QuickPanelControl DataContext="{Binding QuickPanelViewModel}" />

                <Border
                    Height="1.5"
                    Margin="10"
                    Background="{DynamicResource InactiveBrush}"
                    CornerRadius="2" />

                <ld:NavButton IsChecked="{Binding SelectedPage, Mode=TwoWay, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static mvvm:NavigationPage.Home}}">
                    <ld:PackIcon Width="20" Kind="Home" />
                </ld:NavButton>

                <ld:NavButton IsChecked="{Binding SelectedPage, Mode=TwoWay, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static mvvm:NavigationPage.Settings}}">
                    <ld:PackIcon Width="20" Kind="Settings" />
                </ld:NavButton>

            </StackPanel>

            <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" />
        </Grid>

    </Grid>

</ld:LDWindow>
