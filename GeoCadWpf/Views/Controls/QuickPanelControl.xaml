<UserControl
    x:Class="GeoCadWpf.Views.Controls.QuickPanelControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ld="clr-namespace:LegendDesignWpf.Controls;assembly=LegendDesignWpf"
    xmlns:local="clr-namespace:GeoCadWpf.Views.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <ld:FlatButton
        Width="40"
        Height="40"
        VerticalAlignment="Bottom"
        Background="Transparent"
        Click="MenuButton_Click"
        CornerRadius="9"
        Foreground="{DynamicResource InactiveBrush}"
        HoverBrush="{DynamicResource TertiaryBrush}"
        ToolTipFontSize="14"
        ToolTipMaxWidth="200">

        <ld:FlatButton.ContextMenu>
            <ContextMenu Placement="Bottom">
                <MenuItem Command="{Binding ImportCommand}" Header="Импорт" />
                <MenuItem Command="{Binding ExportCommand}" Header="Экспорт" />
            </ContextMenu>
        </ld:FlatButton.ContextMenu>

        <ld:PackIcon
            Width="20"
            Height="20"
            Kind="Folder" />


    </ld:FlatButton>

</UserControl>
