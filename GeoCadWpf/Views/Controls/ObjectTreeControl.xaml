<UserControl
    x:Class="GeoCadWpf.Views.Controls.ObjectTreeControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:GeoCadWpf.Helpers"
    xmlns:local="clr-namespace:GeoCadWpf.Views.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">


    <!--
        do
        
        PreviewMouseRightButtonDown="GeoTree_PreviewMouseRightButtonDown"
    -->

    <TreeView
        x:Name="GeoTree"
        helpers:TreeViewHelper.Header="Объекты"
        ItemsSource="{Binding ItemsSource, RelativeSource={RelativeSource AncestorType=UserControl}}"
        SelectedItemChanged="TreeView_SelectedItemChanged">

        <TreeView.ItemTemplate>
            <DataTemplate>
                <TextBlock Text="{Binding Name}" />
            </DataTemplate>
        </TreeView.ItemTemplate>

        <!--<TreeView.ItemTemplate>
            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                <TextBlock Text="{Binding Name}" />
            </HierarchicalDataTemplate>
        </TreeView.ItemTemplate>-->
    </TreeView>

</UserControl>
