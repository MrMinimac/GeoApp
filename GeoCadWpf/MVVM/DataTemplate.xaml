<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Controls="clr-namespace:GeoCadWpf.Views.Controls"
    xmlns:Pages="clr-namespace:GeoCadWpf.Views.Pages"
    xmlns:vm="clr-namespace:GeoCadWpf.ViewModels">

    <DataTemplate DataType="{x:Type vm:HomeViewModel}">
        <Pages:HomePage />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
        <Pages:SettingsPage />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:WorkspaceViewModel}">
        <Controls:WorkspaceControl />
    </DataTemplate>

</ResourceDictionary>