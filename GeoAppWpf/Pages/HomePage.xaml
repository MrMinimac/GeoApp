<UserControl
    x:Class="GeoAppWpf.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:GeoAppWpf.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ld="clr-namespace:LegendDesignWpf.Controls;assembly=LegendDesignWpf"
    xmlns:local="clr-namespace:GeoAppWpf.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <ld:CustomPage HeaderMaxWidth="{x:Static sys:Double.PositiveInfinity}">
        <ld:CustomPage.PageContent>
            <Grid>
                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <controls:ObjectTreeControl
                        Grid.Row="2"
                        Margin="3,3,0,3"
                        Documents="{Binding Documents}"
                        Visibility="{Binding DocumentsAny, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <GridSplitter
                        Grid.Row="2"
                        Grid.Column="1"
                        Width="5"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Background="Transparent"
                        ResizeBehavior="PreviousAndNext"
                        ShowsPreview="False" />

                    <Border
                        Grid.Row="2"
                        Grid.Column="2"
                        Margin="0,3,3,3"
                        BorderBrush="{DynamicResource InactiveBrush}"
                        BorderThickness="1"
                        CornerRadius="3.5"
                        Visibility="{Binding DocumentsAny, Converter={StaticResource BoolToVisibilityConverter}}">

                        <controls:Viewer3DControl ViewportController="{Binding ViewportController}" />

                    </Border>

                </Grid>

                <TextBlock
                    Margin="0,0,0,50"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource LabelSmallTextStyle}"
                    Text="Загрузите документ, что бы увидеть данные."
                    Visibility="{Binding DocumentsAny, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Reversed}" />
            </Grid>
        </ld:CustomPage.PageContent>
    </ld:CustomPage>

</UserControl>
