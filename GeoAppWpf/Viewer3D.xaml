<ld:LDWindow
    x:Class="GeoAppWpf.Viewer3D"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helix="http://helix-toolkit.org/wpf"
    xmlns:ld="clr-namespace:LegendDesignWpf.Controls;assembly=LegendDesignWpf"
    xmlns:local="clr-namespace:GeoAppWpf"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Viewer3D"
    Width="800"
    Height="450"
    mc:Ignorable="d">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel>
            <Menu DockPanel.Dock="Top">
                <MenuItem Header="_Камера">
                    <MenuItem Click="CameraCenter_Click" Header="Центр" />
                </MenuItem>
                <MenuItem Header="_Масштаб">
                    <MenuItem Click="ChangeScale_Click" Header="Уменьшить на 20%" />
                </MenuItem>
                <MenuItem Header="_Каркас">
                    <MenuItem Click="Build_Click" Header="Построить" />
                </MenuItem>
            </Menu>
        </DockPanel>

        <helix:HelixViewport3D x:Name="Viewport" Grid.Row="1">
            <helix:DefaultLights />
        </helix:HelixViewport3D>
    </Grid>

</ld:LDWindow>
