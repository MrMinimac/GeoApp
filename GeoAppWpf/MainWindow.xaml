<Window x:Class="GeoAppWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GeoAppWpf"
        mc:Ignorable="d"
        Title="GeoCadApp" Height="450" Width="800">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <Button Width="100" Height="20" Content="Load" HorizontalAlignment="Left" Click="ExcelLoadButton_Click"/>
            <Button x:Name="ImportButton" Width="100" Height="20" Content="Import" HorizontalAlignment="Left" Click="ImportInAcadButton_Click"/>
            <Button x:Name="ImportButton2" Width="100" Height="20" Content="Import2" HorizontalAlignment="Left" Click="ImportInAcadButton_Click2"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="10">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Линии -->
            <DataGrid
                x:Name="BoreholeLinesGrid"
                Grid.Column="0"
                AutoGenerateColumns="True"
                IsReadOnly="True"
                Visibility="Collapsed"
                SelectionChanged="BoreholeLinesGrid_SelectionChanged"
                AutoGeneratingColumn="BoreholeLinesGrid_AutoGeneratingColumn"/>

            <GridSplitter
                Grid.Column="1"
                Width="5"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                ResizeBehavior="PreviousAndNext"
                ShowsPreview="True"
                />

            <!-- Скважины -->
            <DataGrid
                x:Name="BoreholesGrid"
                Grid.Column="2"
                AutoGenerateColumns="True"
                IsReadOnly="True"
                Visibility="Collapsed"
                SelectionChanged="BoreholesGrid_SelectionChanged"
                AutoGeneratingColumn="BoreholesGrid_AutoGeneratingColumn"/>

            <GridSplitter
                Grid.Column="3"
                Width="5"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                ResizeBehavior="PreviousAndNext"
                ShowsPreview="True"/>

            <!-- Пробы -->
            <DataGrid
                x:Name="SamplesGrid"
                Grid.Column="4"
                AutoGenerateColumns="True"
                IsReadOnly="True"
                Visibility="Collapsed"
                AutoGeneratingColumn="SamplesGrid_AutoGeneratingColumn"/>

        </Grid>
    </Grid>

</Window>
