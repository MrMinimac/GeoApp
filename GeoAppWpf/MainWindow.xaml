<ld:LDWindow
    x:Class="GeoAppWpf.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:GeoAppWpf.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:enums="clr-namespace:GeoAppWpf.MVVM"
    xmlns:ld="clr-namespace:LegendDesignWpf.Controls;assembly=LegendDesignWpf"
    xmlns:local="clr-namespace:GeoAppWpf"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="GeoCadApp"
    Width="1280"
    Height="720"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:QuickPanelControl DataContext="{Binding QuickPanelViewModel}" />

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="55" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <!--  Правая часть (кнопки навигации)  -->
            <StackPanel Margin="0,8,0,0">
                <ld:NavButton IsChecked="{Binding SelectedPage, Mode=TwoWay, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static enums:NavigationPage.Table}}">
                    <ld:PackIcon Width="20" Kind="Table" />
                </ld:NavButton>
                <ld:NavButton IsChecked="{Binding SelectedPage, Mode=TwoWay, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static enums:NavigationPage.Settings}}">
                    <ld:PackIcon Width="20" Kind="Settings" />
                </ld:NavButton>
            </StackPanel>

            <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" />
        </Grid>

    </Grid>

</ld:LDWindow>
