<Window
    x:Class="GeoAppWpf.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:GeoAppWpf"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="GeoCadApp"
    Width="800"
    Height="450"
    mc:Ignorable="d">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel>
            <Menu DockPanel.Dock="Top">
                <MenuItem Header="_Файл">
                    <MenuItem Click="ExcelLoadButton_Click" Header="Открыть таблицу Excel" />
                    <MenuItem Header="Экспорт в AutoCad">
                        <MenuItem Click="ImportInAcadButton_Click" Header="План" />
                        <MenuItem Click="ImportInAcadButton_Click2" Header="Разрез" />
                    </MenuItem>
                </MenuItem>
            </Menu>
        </DockPanel>

        <Grid
            x:Name="DataGrids"
            Grid.Row="1"
            Margin="10"
            Visibility="Collapsed">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>


            <!--  Буровые линии  -->
            <GroupBox Grid.Column="0" Header="Буровые линии">

                <DataGrid
                    x:Name="BoreholeLinesDataGrid"
                    AutoGenerateColumns="True"
                    AutoGeneratingColumn="BoreholeLinesDataGrid_AutoGeneratingColumn"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    CanUserResizeRows="False"
                    GridLinesVisibility="Horizontal"
                    HeadersVisibility="Column"
                    IsReadOnly="True"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    SelectionChanged="BoreholeLinesDataGrid_SelectionChanged"
                    SelectionMode="Single"
                    SelectionUnit="FullRow" />

            </GroupBox>


            <GridSplitter
                Grid.Column="1"
                Width="5"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                ResizeBehavior="PreviousAndNext"
                ShowsPreview="True" />


            <!--  Скважины  -->
            <GroupBox Grid.Column="2" Header="Скважины">

                <DataGrid
                    x:Name="BoreholesDataGrid"
                    AutoGenerateColumns="True"
                    AutoGeneratingColumn="BoreholesDataGrid_AutoGeneratingColumn"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    CanUserResizeRows="False"
                    GridLinesVisibility="Horizontal"
                    HeadersVisibility="Column"
                    IsReadOnly="True"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    SelectionChanged="BoreholesDataGrid_SelectionChanged"
                    SelectionMode="Single"
                    SelectionUnit="FullRow" />

            </GroupBox>


            <GridSplitter
                Grid.Column="3"
                Width="5"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                ResizeBehavior="PreviousAndNext"
                ShowsPreview="True" />


            <!--  Пробы  -->
            <GroupBox Grid.Column="4" Header="Пробы">

                <DataGrid
                    x:Name="SamplesDataGrid"
                    AutoGenerateColumns="True"
                    AutoGeneratingColumn="SamplesDataGrid_AutoGeneratingColumn"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    CanUserResizeRows="False"
                    GridLinesVisibility="Horizontal"
                    HeadersVisibility="Column"
                    IsReadOnly="True"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    SelectionMode="Single"
                    SelectionUnit="FullRow" />

            </GroupBox>


        </Grid>
    </Grid>

</Window>
