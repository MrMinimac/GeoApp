<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:GeoAppWpf.Views.Controls"
    xmlns:ld="clr-namespace:LegendDesignWpf.Controls;assembly=LegendDesignWpf">

    <RotateTransform x:Key="ArrowDefaultTransform" Angle="90" />
    <RotateTransform x:Key="ArrowExpandedTransform" Angle="180" />

    <Style x:Key="NodeControlStyle" TargetType="{x:Type controls:NodeControl}">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
        <Setter Property="Height" Value="Auto" />
        <Setter Property="Width" Value="Auto" />
        <Setter Property="ToolTipService.InitialShowDelay" Value="100" />
        <Setter Property="ToolTipService.BetweenShowDelay" Value="100" />
        <Setter Property="ToolTipService.ShowDuration" Value="60000" />
        <Setter Property="ToolTip">
            <Setter.Value>
                <ToolTip
                    x:Name="tooltip"
                    Background="Transparent"
                    BorderThickness="0"
                    Placement="Mouse"
                    VerticalOffset="-3">

                    <Border
                        x:Name="border"
                        MaxWidth="300"
                        Padding="10,3,10,3"
                        Background="{DynamicResource TertiaryBrush}"
                        CornerRadius="8"
                        Visibility="{Binding PlacementTarget.ToolTipText, RelativeSource={RelativeSource AncestorType=ToolTip}, Converter={StaticResource StringLengthToVisibilityConverter}}">

                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="10"
                            Foreground="{DynamicResource ForegroundBrush}"
                            Text="{Binding PlacementTarget.ToolTipText, RelativeSource={RelativeSource AncestorType=ToolTip}}"
                            TextWrapping="Wrap" />
                    </Border>
                </ToolTip>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:NodeControl}">
                    <Border
                        x:Name="border"
                        Width="{TemplateBinding Width}"
                        Height="{TemplateBinding Height}"
                        Padding="{TemplateBinding Padding}"
                        HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                        Background="Transparent"
                        BorderBrush="{DynamicResource InactiveBrush}"
                        BorderThickness="0"
                        CornerRadius="4">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border
                                x:Name="marker"
                                Width="3"
                                Margin="4,2,0,2"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Stretch"
                                Background="Transparent"
                                CornerRadius="2" />

                            <ld:FlatToggleButton
                                x:Name="toggle"
                                Grid.Column="1"
                                Width="20"
                                Margin="{TemplateBinding ContentMargin}"
                                Background="Transparent"
                                HoverBrush="{DynamicResource HoverBrush}"
                                IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                SelectedBrush="Transparent"
                                Visibility="{TemplateBinding IsExpandToggleVisible,
                                                             Converter={StaticResource BoolToVisibilityConverter},
                                                             ConverterParameter=Hidden}">
                                <ld:PackIcon
                                    x:Name="arrow"
                                    Grid.Column="1"
                                    Width="6"
                                    HorizontalAlignment="Center"
                                    Foreground="{DynamicResource InactiveBrush}"
                                    Kind="ScrollBarArrow"
                                    LayoutTransform="{StaticResource ArrowDefaultTransform}" />

                            </ld:FlatToggleButton>

                            <ContentPresenter
                                Grid.Column="2"
                                Margin="0,0,0,0"
                                Content="{TemplateBinding Header}" />

                            <ContentPresenter Grid.Column="3" Content="{TemplateBinding ActionButtonContent}" />

                        </Grid>

                    </Border>


                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource SecondaryBrush}" />
                            <Setter TargetName="marker" Property="Background" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.6" />
                        </Trigger>
                        <Trigger SourceName="toggle" Property="IsChecked" Value="True">
                            <Setter TargetName="arrow" Property="LayoutTransform" Value="{StaticResource ArrowExpandedTransform}" />
                        </Trigger>
                        <Trigger SourceName="border" Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource SecondaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ObjectItemControlStyle" TargetType="{x:Type controls:ObjectItemControl}">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
        <Setter Property="Height" Value="Auto" />
        <Setter Property="Width" Value="Auto" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="2,1,2,1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:ObjectItemControl}">
                    <Grid
                        x:Name="templateRoot"
                        Background="Transparent"
                        SnapsToDevicePixels="True">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <controls:NodeControl
                            x:Name="node"
                            Margin="3,0,3,1"
                            Padding="0,3,0,3"
                            ActionButtonContent="{TemplateBinding ActionButtonContent}"
                            ContentMargin="{TemplateBinding ContentMargin}"
                            Header="{Binding Node.Header, RelativeSource={RelativeSource TemplatedParent}}"
                            IsExpandToggleVisible="{Binding Node.Children.Count, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource IntToBoolConverter}}"
                            IsExpanded="{Binding Node.IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                            IsSelected="{Binding Node.IsSelected, RelativeSource={RelativeSource TemplatedParent}}"
                            Node="{TemplateBinding Node}"
                            SelectCommand="{TemplateBinding SelectCommand}"
                            ToolTipText="{Binding Node.ToolTipText, RelativeSource={RelativeSource TemplatedParent}}">

                            <!--  // Context Menu //  -->
                            <controls:NodeControl.ContextMenu>
                                <ContextMenu ItemsSource="{Binding MenuItems}" Visibility="{Binding HasMenuItems, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <ContextMenu.ItemContainerStyle>
                                        <Style TargetType="MenuItem">
                                            <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            <Setter Property="Header" Value="{Binding Header}" />
                                            <Setter Property="Command" Value="{Binding Command}" />
                                            <Setter Property="CommandParameter" Value="{Binding CommandParameter}" />
                                            <Setter Property="ItemsSource" Value="{Binding Items}" />
                                        </Style>
                                    </ContextMenu.ItemContainerStyle>
                                </ContextMenu>
                            </controls:NodeControl.ContextMenu>

                        </controls:NodeControl>

                        <ItemsControl
                            x:Name="items"
                            Grid.Row="1"
                            ItemsSource="{Binding Node.Children, RelativeSource={RelativeSource TemplatedParent}}"
                            VirtualizingPanel.IsVirtualizing="True"
                            VirtualizingPanel.ScrollUnit="Pixel"
                            VirtualizingPanel.VirtualizationMode="Recycling"
                            Visibility="Collapsed">

                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <controls:ObjectItemControl
                                        ContentMargin="10,0,0,0"
                                        Node="{Binding}"
                                        SelectCommand="{Binding SelectCommand, RelativeSource={RelativeSource AncestorType={x:Type controls:ObjectItemControl}}}"
                                        Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger SourceName="node" Property="IsExpanded" Value="True">
                            <Setter TargetName="items" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TreeViewButtonStyle" TargetType="{x:Type ld:FlatButton}">
        <Setter Property="Foreground" Value="{DynamicResource IconBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HoverBrush" Value="{DynamicResource HoverBrush}" />
    </Style>

</ResourceDictionary>