<UserControl
    x:Class="GeoAppWpf.Controls.Viewer3DControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helix="http://helix-toolkit.org/wpf"
    xmlns:local="clr-namespace:GeoAppWpf.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel>
            <Menu DockPanel.Dock="Top">
                <MenuItem Header="_Камера">
                    <MenuItem Header="Центр" />
                </MenuItem>
                <MenuItem Header="_Масштаб">
                    <MenuItem Header="Уменьшить на 20%" />
                </MenuItem>
                <MenuItem Header="_Каркас">
                    <MenuItem Header="Построить" />
                </MenuItem>
            </Menu>
        </DockPanel>

        <helix:HelixViewport3D x:Name="Viewport" Grid.Row="1">
            <helix:DefaultLights />
        </helix:HelixViewport3D>
    </Grid>

</UserControl>
