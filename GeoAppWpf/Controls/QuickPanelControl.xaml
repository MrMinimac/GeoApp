<UserControl
    x:Class="GeoAppWpf.Controls.QuickPanelControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:GeoAppWpf.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Файл">
                <MenuItem Command="{Binding ImportFromExcel}" Header="Открыть таблицу Excel" />
                <MenuItem Command="{Binding ImportDXF}" Header="Открыть DXF файл" />
                <MenuItem Header="Экспорт в AutoCad">
                    <MenuItem Command="{Binding ExportPlanInACAD}" Header="План" />
                    <MenuItem Command="{Binding ExportSectionsInACAD}" Header="Разрез" />
                </MenuItem>
            </MenuItem>
        </Menu>
    </DockPanel>

</UserControl>
