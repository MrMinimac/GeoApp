<UserControl
    x:Class="GeoAppWpf.Views.Components.LastFilesComponent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ld="clr-namespace:LegendDesignWpf.Controls;assembly=LegendDesignWpf"
    xmlns:local="clr-namespace:GeoAppWpf.Views.Components"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>

        <TextBlock
            Grid.Row="0"
            MaxWidth="250"
            Margin="10,0,0,10"
            VerticalAlignment="Center"
            FontSize="16"
            Style="{StaticResource LabelSmallTextStyle}"
            Text="Данных нет, загрузите документ."
            TextAlignment="Center"
            TextWrapping="Wrap"
            Visibility="{Binding LastFiles.Count, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=Reversed}" />

        <Grid Visibility="{Binding LastFiles.Count, Converter={StaticResource IntToVisibilityConverter}}">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                MaxWidth="1000"
                Margin="10,0,0,10"
                FontSize="16"
                Foreground="{DynamicResource ForegroundSecondaryBrush}"
                Text="Последние загруженные файлы"
                TextAlignment="Left" />

            <ld:CustomListBox
                Grid.Row="1"
                ItemsSource="{Binding LastFiles}"
                VerticalScrollBarVisibility="Visible">
                <ld:CustomListBox.ItemTemplate>
                    <DataTemplate>
                        <ld:FlatButton
                            Height="Auto"
                            MaxWidth="1000"
                            Margin="10,0,10,5"
                            HorizontalAlignment="Stretch"
                            Background="{DynamicResource SecondaryBrush}"
                            Command="{Binding DataContext.LoadFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            ContentHorizontalAlignment="Stretch"
                            CornerRadius="8"
                            HoverBrush="{DynamicResource HoverBrush}">
                            
                            <Grid>
                                <StackPanel
                                    Margin="20,7,20,7"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center">
                                    <TextBlock
                                        HorizontalAlignment="Left"
                                        FontSize="13"
                                        Foreground="{DynamicResource ForegroundBrush}"
                                        Text="{Binding Name}"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        HorizontalAlignment="Left"
                                        FontSize="11"
                                        Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                        Text="{Binding Directory}"
                                        TextAlignment="Center" />
                                    <TextBlock
                                        HorizontalAlignment="Left"
                                        FontSize="11"
                                        Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                        Text="{Binding LastModified, StringFormat=dd.MM.yy HH:mm}"
                                        TextAlignment="Center" />
                                </StackPanel>

                                <ld:FlatButton
                                    Width="Auto"
                                    Height="Auto"
                                    Margin="0,0,10,0"
                                    Padding="12"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    Command="{Binding DataContext.RemoveFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    HoverBrush="{DynamicResource TertiaryBrush}">
                                    <ld:PackIcon
                                        Width="12"
                                        Foreground="{DynamicResource ForegroundBrush}"
                                        Kind="Close" />
                                </ld:FlatButton>

                            </Grid>
                        </ld:FlatButton>
                    </DataTemplate>
                </ld:CustomListBox.ItemTemplate>

            </ld:CustomListBox>


        </Grid>
    </Grid>

</UserControl>
