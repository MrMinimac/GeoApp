<UserControl
    x:Class="GeoAppWpf.Views.Components.LastFilesComponent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ld="clr-namespace:LegendDesignWpf.Controls;assembly=LegendDesignWpf"
    xmlns:local="clr-namespace:GeoAppWpf.Views.Components"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            FontSize="14"
            Style="{StaticResource LabelSmallTextStyle}"
            Text="Загрузите документ, что бы увидеть данные."
            TextAlignment="Center"
            TextWrapping="Wrap" />

        <StackPanel
            Grid.Row="1"
            Margin="0,10,0,0"
            Visibility="{Binding LastFiles.Count, Converter={StaticResource IntToVisibilityConverter}}">

            <TextBlock
                Margin="0,0,0,10"
                FontSize="13"
                Foreground="{DynamicResource ForegroundSecondaryBrush}"
                Text="Последние:"
                TextAlignment="Center" />

            <ItemsControl HorizontalAlignment="Center" ItemsSource="{Binding LastFiles}">

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel MaxWidth="400" HorizontalAlignment="Center" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ld:FlatButton
                            Width="190"
                            Height="80"
                            Margin="0,0,5,5"
                            Background="{DynamicResource AccentBrush}"
                            Command="{Binding DataContext.LoadFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            CornerRadius="8">
                            <StackPanel
                                Margin="20,0,20,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="13"
                                    Foreground="{DynamicResource ForegroundBrush}"
                                    Text="{Binding Name}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="11"
                                    Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                    Text="{Binding Directory}"
                                    TextAlignment="Center" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="11"
                                    Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                    Text="{Binding LastModified, StringFormat=dd.MM.yy HH:mm}"
                                    TextAlignment="Center" />
                            </StackPanel>
                        </ld:FlatButton>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

    </Grid>

</UserControl>
