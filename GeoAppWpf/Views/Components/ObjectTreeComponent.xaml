<UserControl
    x:Class="GeoAppWpf.Views.Components.ObjectTreeComponent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:GeoAppWpf.Views.Components"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <TreeView
        x:Name="GeoTree"
        ItemsSource="{Binding Documents, RelativeSource={RelativeSource AncestorType=UserControl}}"
        PreviewMouseRightButtonDown="GeoTree_PreviewMouseRightButtonDown"
        SelectedItemChanged="TreeView_SelectedItemChanged">

        <TreeView.ItemTemplate>
            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                <TextBlock Text="{Binding Header}" />
            </HierarchicalDataTemplate>
        </TreeView.ItemTemplate>
    </TreeView>

</UserControl>
