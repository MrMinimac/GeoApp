<UserControl
    x:Class="GeoAppWpf.Views.Components.StatusBarComponent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:GeoAppWpf.Views.Components"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="ToolTipService.InitialShowDelay" Value="100" />
                <Setter Property="ToolTipService.BetweenShowDelay" Value="100" />
                <Setter Property="ToolTipService.ShowDuration" Value="60000" />
                <Setter Property="ToolTip">
                    <Setter.Value>
                        <ToolTip
                            Background="Transparent"
                            BorderThickness="0"
                            Placement="Mouse"
                            VerticalOffset="-3">

                            <Border
                                MaxWidth="300"
                                Padding="10,3,10,3"
                                Background="{DynamicResource TertiaryBrush}"
                                CornerRadius="8">

                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="10"
                                    Foreground="{DynamicResource ForegroundBrush}"
                                    TextWrapping="Wrap">

                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Не подключено" />

                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AutoCadStatus}" Value="True">
                                                    <Setter Property="Text" Value="Подключено" />
                                                </DataTrigger>
                                            </Style.Triggers>

                                        </Style>
                                    </TextBlock.Style>

                                </TextBlock>

                            </Border>

                        </ToolTip>
                    </Setter.Value>
                </Setter>
            </Style>
        </Border.Style>

        <Grid>

            <StackPanel
                Margin="1,1,5,1"
                HorizontalAlignment="Right"
                Orientation="Horizontal">

                <TextBlock
                    Margin="0,0,5,0"
                    VerticalAlignment="Center"
                    Foreground="{StaticResource ForegroundSecondaryBrush}"
                    Text="AutoCAD" />

                <Border
                    Width="8"
                    Height="8"
                    Margin="0,1,0,0"
                    VerticalAlignment="Center"
                    CornerRadius="5">

                    <Border.Style>
                        <Style TargetType="Border">

                            <Setter Property="Background" Value="Red" />


                            <Style.Triggers>

                                <DataTrigger Binding="{Binding AutoCadStatus}" Value="True">

                                    <Setter Property="Background" Value="Green" />

                                </DataTrigger>

                            </Style.Triggers>

                        </Style>
                    </Border.Style>

                </Border>

            </StackPanel>

        </Grid>

    </Border>

</UserControl>
