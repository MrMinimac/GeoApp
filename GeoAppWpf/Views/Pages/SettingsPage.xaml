<UserControl
    x:Class="GeoAppWpf.Views.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ld="clr-namespace:LegendDesignWpf.Controls;assembly=LegendDesignWpf"
    xmlns:local="clr-namespace:GeoAppWpf.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <ld:CustomPage Title="Настройки">
        <ld:CustomPage.PageContent>
            <ScrollViewer
                CanContentScroll="False"
                PanningMode="VerticalOnly"
                VerticalScrollBarVisibility="Visible">
                <StackPanel MaxWidth="1000" Margin="0,0,30,20">
                    <!--  Theme  -->
                    <ld:ExpandableSettingItem
                        Title="Тема приложения"
                        Margin="0,0,0,10"
                        Description="Изменяет тему приложения.">
                        <ld:ExpandableSettingItem.ExpandedContent>
                            <ItemsControl
                                Height="30"
                                Margin="0,15,0,15"
                                ItemsSource="{Binding ThemeValues}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton
                                            Margin="0,0,10,0"
                                            Command="{Binding DataContext.ChangeThemeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Content="{Binding}"
                                            GroupName="AppThemeGroup">
                                            <RadioButton.IsChecked>
                                                <MultiBinding Converter="{StaticResource EqualityMultiConverter}" Mode="OneWay">
                                                    <Binding Path="DataContext.AppTheme" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                    <Binding Path="." />
                                                </MultiBinding>
                                            </RadioButton.IsChecked>
                                        </RadioButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ld:ExpandableSettingItem.ExpandedContent>
                    </ld:ExpandableSettingItem>

                    <!--  Accent Color  -->
                    <ld:ExpandableSettingItem
                        Title="Акцентный цвет"
                        Margin="0,0,0,10"
                        Description="Изменяет акцентный цвет приложения.">
                        <ld:ExpandableSettingItem.ExpandedContent>
                            <ItemsControl
                                Height="30"
                                Margin="0,15,0,15"
                                ItemsSource="{Binding AccentSourceValues}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton
                                            Margin="0,0,10,0"
                                            Command="{Binding DataContext.ChangeAccentSourceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Content="{Binding}"
                                            GroupName="AccentSourceGroup">
                                            <RadioButton.IsChecked>
                                                <MultiBinding Converter="{StaticResource EqualityMultiConverter}" Mode="OneWay">
                                                    <Binding Path="DataContext.AccentSource" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                    <Binding Path="." />
                                                </MultiBinding>
                                            </RadioButton.IsChecked>
                                        </RadioButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ld:ExpandableSettingItem.ExpandedContent>
                    </ld:ExpandableSettingItem>

                </StackPanel>
            </ScrollViewer>
        </ld:CustomPage.PageContent>
    </ld:CustomPage>

</UserControl>
