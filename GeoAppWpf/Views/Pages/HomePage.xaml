<UserControl
    x:Class="GeoAppWpf.Views.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="clr-namespace:GeoAppWpf.Views.Components"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ld="clr-namespace:LegendDesignWpf.Controls;assembly=LegendDesignWpf"
    xmlns:local="clr-namespace:GeoAppWpf.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="BorderStyle" TargetType="Border">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="BorderBrush" Value="{DynamicResource InactiveStrokeBrush}" />
        </Style>
    </UserControl.Resources>

    <ld:CustomPage HeaderMaxWidth="{x:Static sys:Double.PositiveInfinity}">
        <ld:CustomPage.PageContent>
            <Grid>
                <Grid Visibility="{Binding DocumentsAny, Converter={StaticResource BoolToVisibilityConverter}}">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <Border Margin="3,3,0,3" Style="{StaticResource BorderStyle}">

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Margin="7,3,0,3"
                                Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                Text="Обозреватель" />

                            <components:ObjectTreeComponent
                                Grid.Row="2"
                                Nodes="{Binding Nodes}"
                                SelectNodeCommand="{Binding SelectNodeCommand}" />

                        </Grid>

                    </Border>

                    <GridSplitter
                        Grid.Row="2"
                        Grid.Column="1"
                        Width="5"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Background="Transparent"
                        ResizeBehavior="PreviousAndNext"
                        ShowsPreview="False" />

                    <Border
                        Grid.Row="2"
                        Grid.Column="2"
                        Margin="0,3,3,3"
                        Style="{StaticResource BorderStyle}">

                        <Grid>

                            <Grid Visibility="{Binding SelectedNode, Converter={StaticResource NullToVisibilityConverter}}">

                                <components:TableComponent ItemsSource="{Binding DisplayItems}" Visibility="{Binding DisplayItems.Count, Converter={StaticResource IntToVisibilityConverter}}" />

                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                    Text="Нет Данных"
                                    Visibility="{Binding DisplayItems.Count, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=Reversed}" />

                            </Grid>

                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                Text="Выберите элемент для отображения данных."
                                Visibility="{Binding SelectedNode, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Reversed}" />

                        </Grid>

                    </Border>

                </Grid>

                <TextBlock
                    Margin="0,0,0,50"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource LabelSmallTextStyle}"
                    Text="Загрузите документ, что бы увидеть данные."
                    Visibility="{Binding DocumentsAny, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Reversed}" />
            </Grid>
        </ld:CustomPage.PageContent>
    </ld:CustomPage>

</UserControl>
