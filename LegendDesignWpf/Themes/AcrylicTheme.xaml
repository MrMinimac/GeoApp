<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ldc="clr-namespace:LegendDesignWpf.Controls"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:Boolean x:Key="ThemeMarker">True</sys:Boolean>

    <!--  ===================== COLORS =====================  -->

    <Color x:Key="AccentPaint">#8540B4</Color>
    <Color x:Key="AccentPaintDark">#712CA0</Color>
    <Color x:Key="AccentPaintLight">#9954C8</Color>

    <Color x:Key="PrimaryPaint">#50000000</Color>
    <Color x:Key="SecondaryPaint">#50000000</Color>
    <Color x:Key="TertiaryPaint">#70000000</Color>

    <Color x:Key="ForegroundPaint">#FFFFFFFF</Color>
    <Color x:Key="ForegroundSecondaryPaint">#99FFFFFF</Color>
    <Color x:Key="ForegroundTertiaryPaint">#EEEEEE</Color>

    <Color x:Key="InactiveStrokePaint">#4E4E4E</Color>
    <Color x:Key="InactivePaint">#70FFFFFF</Color>
    <Color x:Key="IconPaint">#C3C3C3</Color>
    <Color x:Key="HoverPaint">#70000000</Color>

    <Color x:Key="ScrollThumbPaint">#90FFFFFF</Color>
    <Color x:Key="SliderBackgroundPaint">#5C5C5C</Color>
    <Color x:Key="ErrorPaint">#BF001A</Color>
    <Color x:Key="SuccessPaint">#00A72C</Color>

    <Color x:Key="GradientPaint">#25FFFFFF</Color>
    <Color x:Key="BorderShadowPaint">#000000</Color>

    <!--  ===================== BRUSHES =====================  -->

    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentPaint}" />
    <SolidColorBrush x:Key="AccentBrushDark" Color="{DynamicResource AccentPaintDark}" />
    <SolidColorBrush x:Key="AccentBrushLight" Color="{DynamicResource AccentPaintLight}" />

    <SolidColorBrush x:Key="PrimaryBrush" Color="{DynamicResource PrimaryPaint}" />
    <SolidColorBrush x:Key="SecondaryBrush" Color="{DynamicResource SecondaryPaint}" />
    <SolidColorBrush x:Key="TertiaryBrush" Color="{DynamicResource TertiaryPaint}" />

    <SolidColorBrush x:Key="ForegroundBrush" Color="{DynamicResource ForegroundPaint}" />
    <SolidColorBrush x:Key="ForegroundSecondaryBrush" Color="{DynamicResource ForegroundSecondaryPaint}" />
    <SolidColorBrush x:Key="ForegroundTertiaryBrush" Color="{DynamicResource ForegroundTertiaryPaint}" />

    <SolidColorBrush x:Key="InactiveStrokeBrush" Color="{StaticResource InactiveStrokePaint}" />
    <SolidColorBrush x:Key="InactiveBrush" Color="{DynamicResource InactivePaint}" />
    <SolidColorBrush x:Key="IconBrush" Color="{DynamicResource IconPaint}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverPaint}" />

    <SolidColorBrush x:Key="ScrollThumbBrush" Color="{DynamicResource ScrollThumbPaint}" />
    <SolidColorBrush x:Key="SliderBackgroundBrush" Color="{DynamicResource SliderBackgroundPaint}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{DynamicResource ErrorPaint}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessPaint}" />

    <!--  ===================== OtherBrushes =====================  -->

    <SolidColorBrush x:Key="WindowButtonsHoverBrush" Color="#40999999" />
    <SolidColorBrush x:Key="BackgroundPage" Color="#64141414" />
    <SolidColorBrush x:Key="BackgroundToolBar" Color="#70000000" />

    <!--  ===================== STYLES =====================  -->

    <Style x:Key="WindowButtonStyle" TargetType="{x:Type ldc:FlatButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="HoverBrush" Value="{StaticResource WindowButtonsHoverBrush}" />
        <Setter Property="Foreground" Value="{StaticResource ForegroundSecondaryBrush}" />
    </Style>

    <Style x:Key="WindowButtonIconStyle" TargetType="{x:Type ldc:PackIcon}">
        <Setter Property="Height" Value="11" />
        <Setter Property="Margin" Value="15,0" />
    </Style>

    <Style x:Key="LDWindowStyle" TargetType="{x:Type ldc:LDWindow}">
        <Setter Property="AllowsTransparency" Value="True" />
        <Setter Property="ResizeMode" Value="CanResize" />
        <Setter Property="WindowStyle" Value="None" />
        <Setter Property="Background" Value="{DynamicResource BackgroundPage}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ldc:LDWindow}">
                    <Border Background="{TemplateBinding Background}">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30" />
                                <RowDefinition />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Margin="15,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="14"
                                Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                Text="{TemplateBinding Title}" />

                            <StackPanel
                                x:Name="PART_WindowButtons"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <ldc:FlatButton x:Name="MinimizeButton" Style="{StaticResource WindowButtonStyle}">
                                    <ldc:PackIcon Kind="Minimize" Style="{StaticResource WindowButtonIconStyle}" />
                                </ldc:FlatButton>
                                <ldc:FlatButton x:Name="MaximizeButton" Style="{StaticResource WindowButtonStyle}">
                                    <ldc:PackIcon Kind="Maximize" Style="{StaticResource WindowButtonIconStyle}" />
                                </ldc:FlatButton>
                                <ldc:FlatButton x:Name="CloseButton" Style="{StaticResource WindowButtonStyle}">
                                    <ldc:PackIcon Kind="Close" Style="{StaticResource WindowButtonIconStyle}" />
                                </ldc:FlatButton>
                            </StackPanel>

                            <AdornerDecorator Grid.Row="1">
                                <ContentPresenter />
                            </AdornerDecorator>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>