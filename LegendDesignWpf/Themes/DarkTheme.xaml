<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ldc="clr-namespace:LegendDesignWpf.Controls"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:Boolean x:Key="ThemeMarker">True</sys:Boolean>

    <!--  ===================== COLORS =====================  -->

    <Color x:Key="AccentPaint">#8540B4</Color>
    <Color x:Key="AccentPaintDark">#712CA0</Color>
    <Color x:Key="AccentPaintLight">#9954C8</Color>

    <Color x:Key="PrimaryPaint">#202020</Color>
    <Color x:Key="SecondaryPaint">#2C2C2C</Color>
    <Color x:Key="TertiaryPaint">#181818</Color>

    <Color x:Key="ForegroundPaint">#EEEEEE</Color>
    <Color x:Key="ForegroundSecondaryPaint">#C4C4C4</Color>
    <Color x:Key="ForegroundTertiaryPaint">#EEEEEE</Color>

    <Color x:Key="InactiveStrokePaint">#4E4E4E</Color>
    <Color x:Key="InactivePaint">#AAAAAA</Color>
    <Color x:Key="IconPaint">#999999</Color>
    <Color x:Key="HoverPaint">#3D3D3D</Color>

    <Color x:Key="ScrollThumbPaint">#7D7D7D</Color>
    <Color x:Key="SliderBackgroundPaint">#4C4C4C</Color>
    <Color x:Key="ErrorPaint">#BF001A</Color>
    <Color x:Key="SuccessPaint">#00A72C</Color>

    <Color x:Key="GradientPaint">#25FFFFFF</Color>
    <Color x:Key="BorderShadowPaint">#000000</Color>

    <!--  ===================== BRUSHES =====================  -->

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentPaint}" />
    <SolidColorBrush x:Key="AccentBrushDark" Color="{StaticResource AccentPaintDark}" />
    <SolidColorBrush x:Key="AccentBrushLight" Color="{StaticResource AccentPaintLight}" />

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryPaint}" />
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryPaint}" />
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource TertiaryPaint}" />

    <SolidColorBrush x:Key="ForegroundBrush" Color="{StaticResource ForegroundPaint}" />
    <SolidColorBrush x:Key="ForegroundSecondaryBrush" Color="{StaticResource ForegroundSecondaryPaint}" />
    <SolidColorBrush x:Key="ForegroundTertiaryBrush" Color="{StaticResource ForegroundTertiaryPaint}" />

    <SolidColorBrush x:Key="InactiveStrokeBrush" Color="{StaticResource InactiveStrokePaint}" />
    <SolidColorBrush x:Key="InactiveBrush" Color="{StaticResource InactivePaint}" />
    <SolidColorBrush x:Key="IconBrush" Color="{StaticResource IconPaint}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverPaint}" />

    <SolidColorBrush x:Key="ScrollThumbBrush" Color="{StaticResource ScrollThumbPaint}" />
    <SolidColorBrush x:Key="SliderBackgroundBrush" Color="{StaticResource SliderBackgroundPaint}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorPaint}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessPaint}" />

    <!--  ===================== STYLES =====================  -->

    <Style x:Key="LDWindowStyle" TargetType="{x:Type ldc:LDWindow}">
        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
    </Style>

</ResourceDictionary>