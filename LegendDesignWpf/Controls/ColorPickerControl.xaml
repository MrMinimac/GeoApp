<UserControl
    x:Class="LegendDesignWpf.Controls.ColorPickerControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:LegendDesignWpf.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:LegendDesignWpf.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="300"
    Height="370"
    d:DesignHeight="370"
    d:DesignWidth="300"
    DataContext="{Binding RelativeSource={RelativeSource Self}}"
    mc:Ignorable="d">


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="SvGrid" SizeChanged="SvArea_SizeChanged">

            <Rectangle HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0" Color="White" />
                        <GradientStop Offset="1" Color="{Binding PureHueColor}" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <Rectangle HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="#00FFFFFF" />
                        <GradientStop Offset="1" Color="#FF000000" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <Canvas
                x:Name="SvCanvas"
                Background="Transparent"
                MouseDown="SvMouse"
                MouseMove="SvMouse">

                <Ellipse
                    Canvas.Left="{Binding MarkerX}"
                    Canvas.Top="{Binding MarkerY}"
                    Width="15"
                    Height="15"
                    Fill="Transparent"
                    IsHitTestVisible="False"
                    Stroke="White"
                    StrokeThickness="3">
                    <Ellipse.Effect>
                        <DropShadowEffect
                            BlurRadius="6"
                            Opacity="0.5"
                            ShadowDepth="2"
                            Color="Black" />
                    </Ellipse.Effect>
                </Ellipse>
            </Canvas>
        </Grid>

        <Slider
            Grid.Row="1"
            Height="20"
            Margin="0,10"
            Maximum="360"
            Minimum="0"
            Style="{DynamicResource HueSliderStyle}"
            Value="{Binding Hue, Mode=TwoWay}" />

        <Grid Grid.Row="2" Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>


            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <Border
                    Margin="0,0,5,0"
                    Background="{DynamicResource PrimaryBrush}"
                    CornerRadius="5">
                    <TextBlock
                        Margin="7,0"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource ForegroundBrush}"
                        Text="RGB" />
                </Border>

                <Border
                    Grid.Column="1"
                    Margin="0,0,5,0"
                    Padding="3,0"
                    HorizontalAlignment="Left"
                    Background="{DynamicResource PrimaryBrush}"
                    CornerRadius="5">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>

                        <TextBox
                            d:Text="255"
                            Style="{DynamicResource TextBoxRGBStyle}"
                            Text="{Binding R, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TextAlignment="Center" />
                        <Border
                            Grid.Column="1"
                            Width="0.5"
                            VerticalAlignment="Stretch"
                            Background="{DynamicResource ForegroundSecondaryBrush}" />
                        <TextBox
                            Grid.Column="2"
                            d:Text="255"
                            Style="{DynamicResource TextBoxRGBStyle}"
                            Text="{Binding G, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TextAlignment="Center" />
                        <Border
                            Grid.Column="3"
                            Width="0.5"
                            VerticalAlignment="Stretch"
                            Background="{DynamicResource ForegroundSecondaryBrush}" />
                        <TextBox
                            Grid.Column="4"
                            d:Text="255"
                            Style="{DynamicResource TextBoxRGBStyle}"
                            Text="{Binding B, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TextAlignment="Center" />
                    </Grid>
                </Border>

            </Grid>
        </Grid>
    </Grid>
</UserControl>