<UserControl
    x:Class="LegendDesignWpf.Controls.Switch"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:LegendDesignWpf.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Border
        x:Name="Body"
        Grid.Column="1"
        Width="40"
        Height="25"
        HorizontalAlignment="Right"
        Background="Transparent"
        BorderBrush="Green"
        BorderThickness="3"
        CornerRadius="10"
        Cursor="Hand"
        MouseLeftButtonDown="OnToggle">

        <Canvas>
            <Border
                x:Name="Thumb"
                Canvas.Top="2.5"
                Width="14"
                Height="14"
                Background="Gray"
                CornerRadius="9" />
        </Canvas>
    </Border>
</UserControl>
