<UserControl
    x:Class="LegendDesignWpf.Controls.ExpandableSettingItem"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:LegendDesignWpf.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:LegendDesignWpf.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style TargetType="{x:Type local:ExpandableSettingItem}">
            <Setter Property="Opacity" Value="1" />

            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <conv:StringLengthToVisibilityConverter x:Key="StringLengthToVisibilityConverter" />

    </UserControl.Resources>

    <Border
        Background="{DynamicResource SecondaryBrush}"
        CornerRadius="8"
        MouseLeftButtonDown="Header_MouseLeftButtonDown">

        <StackPanel Margin="20,10,20,10">

            <!--  HEADER  -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock
                        FontSize="15"
                        FontWeight="DemiBold"
                        Foreground="{DynamicResource ForegroundBrush}"
                        Text="{Binding Title, RelativeSource={RelativeSource AncestorType=local:ExpandableSettingItem}}" />
                    <TextBlock
                        FontSize="13"
                        Foreground="{DynamicResource ForegroundSecondaryBrush}"
                        Opacity="0.7"
                        Text="{Binding Description, RelativeSource={RelativeSource AncestorType=local:ExpandableSettingItem}}"
                        TextWrapping="Wrap"
                        Visibility="{Binding Description, RelativeSource={RelativeSource AncestorType=local:ExpandableSettingItem}, Converter={StaticResource StringLengthToVisibilityConverter}}" />
                </StackPanel>

                <!--  Стрелка  -->
                <Viewbox
                    Grid.Column="1"
                    Width="16"
                    Height="16"
                    Margin="15,0,0,0">
                    <Path
                        Data="M 0 0 L 5 5 L 10 0"
                        Stretch="Uniform"
                        Stroke="{DynamicResource AccentBrush}"
                        StrokeEndLineCap="Round"
                        StrokeLineJoin="Round"
                        StrokeStartLineCap="Round"
                        StrokeThickness="4">
                        <Path.RenderTransform>
                            <RotateTransform x:Name="ArrowRotate" Angle="0" CenterX="7" CenterY="5" />
                        </Path.RenderTransform>
                    </Path>
                </Viewbox>
            </Grid>

            <!--  CONTENT  -->
            <Border
                x:Name="ContentHost"
                Height="0"
                ClipToBounds="True">
                <ContentPresenter x:Name="ContentPresenter" />
            </Border>


        </StackPanel>
    </Border>

</UserControl>
