<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:LegendDesignWpf.Behaviors"
    xmlns:converters="clr-namespace:LegendDesignWpf.Converters">

    <converters:SecondsToTimeConverter x:Key="SecondsToTimeConverter" />

    <Style x:Key="TrackLineStyle" TargetType="{x:Type RepeatButton}">
        <Setter Property="OverridesDefaultStyle" Value="true" />
        <Setter Property="IsTabStop" Value="false" />
        <Setter Property="Focusable" Value="false" />
        <Setter Property="Margin" Value="0" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border
                        Height="2"
                        Margin="0"
                        VerticalAlignment="Center"
                        Background="{TemplateBinding Background}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="ModernSliderThumbHorizontal" TargetType="{x:Type Thumb}">
        <Grid
            Margin="-5"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            UseLayoutRounding="True">

            <Ellipse
                x:Name="grip"
                Width="10"
                Height="10"
                Fill="{DynamicResource AccentBrush}"
                Visibility="Hidden" />

            <!--  зона захвата  -->
            <Ellipse
                Width="0"
                Height="20"
                Fill="Transparent" />

        </Grid>

        <ControlTemplate.Triggers>

            <!--  🔥 Наведение на ВЕСЬ Slider  -->
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Slider}}" Value="True">
                <Setter TargetName="grip" Property="Visibility" Value="Visible" />
                <Setter TargetName="grip" Property="Width" Value="12" />
                <Setter TargetName="grip" Property="Height" Value="12" />
            </DataTrigger>

            <!--  Drag всегда показывает  -->
            <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="grip" Property="Visibility" Value="Visible" />
                <Setter TargetName="grip" Property="Width" Value="12" />
                <Setter TargetName="grip" Property="Height" Value="12" />
            </Trigger>

            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="grip" Property="Fill" Value="#FF999999" />
            </Trigger>

        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="PlayerSliderHorizontal" TargetType="{x:Type Slider}">
        <Grid>

            <Popup
                x:Name="HoverToolTip"
                AllowsTransparency="True"
                IsHitTestVisible="False"
                IsOpen="False"
                Placement="Relative"
                PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                StaysOpen="True"
                VerticalOffset="-25">

                <Border
                    Width="40"
                    Height="20"
                    Margin="0,0,0,0"
                    Background="{DynamicResource TertiaryBrush}"
                    CornerRadius="8">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{DynamicResource ForegroundBrush}"
                        Text="{Binding RelativeSource={RelativeSource AncestorType=Slider}, Path=(behaviors:SliderHoverTimeBehavior.HoverValue), Converter={StaticResource SecondsToTimeConverter}}" />
                </Border>

            </Popup>

            <Border
                x:Name="border"
                Background="Transparent"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                SnapsToDevicePixels="True">

                <Grid VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" MinHeight="{TemplateBinding MinHeight}" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TickBar
                        x:Name="TopTick"
                        Grid.Row="0"
                        Height="4"
                        Margin="0,0,0,0"
                        Fill="{TemplateBinding Foreground}"
                        Placement="Top"
                        Visibility="Collapsed" />

                    <TickBar
                        x:Name="BottomTick"
                        Grid.Row="2"
                        Height="4"
                        Margin="0,0,0,0"
                        Fill="{TemplateBinding Foreground}"
                        Placement="Bottom"
                        Visibility="Collapsed" />

                    <Track x:Name="PART_Track" Grid.Row="1">
                        <Track.DecreaseRepeatButton>
                            <RepeatButton
                                Margin="0"
                                HorizontalAlignment="Stretch"
                                Background="{DynamicResource AccentBrush}"
                                Command="{x:Static Slider.DecreaseLarge}"
                                Style="{StaticResource TrackLineStyle}" />
                        </Track.DecreaseRepeatButton>

                        <Track.IncreaseRepeatButton>
                            <RepeatButton
                                Margin="0"
                                HorizontalAlignment="Stretch"
                                Background="{DynamicResource SliderBackgroundBrush}"
                                Command="{x:Static Slider.IncreaseLarge}"
                                Style="{StaticResource TrackLineStyle}" />
                        </Track.IncreaseRepeatButton>

                        <Track.Thumb>
                            <Thumb
                                x:Name="Thumb"
                                Margin="0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Focusable="False"
                                OverridesDefaultStyle="True"
                                Template="{StaticResource ModernSliderThumbHorizontal}" />
                        </Track.Thumb>
                    </Track>
                </Grid>
            </Border>
        </Grid>

        <ControlTemplate.Triggers>
            <Trigger Property="TickPlacement" Value="TopLeft">
                <Setter TargetName="TopTick" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="TickPlacement" Value="BottomRight">
                <Setter TargetName="BottomTick" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="TickPlacement" Value="Both">
                <Setter TargetName="TopTick" Property="Visibility" Value="Visible" />
                <Setter TargetName="BottomTick" Property="Visibility" Value="Visible" />
            </Trigger>
            <!--  Показываем tooltip при наведении  -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="HoverToolTip" Property="IsOpen" Value="True" />
                <Setter TargetName="border" Property="Opacity" Value="1" />
            </Trigger>

            <Trigger Property="IsMouseOver" Value="False">
                <Setter TargetName="HoverToolTip" Property="IsOpen" Value="False" />
                <Setter TargetName="border" Property="Opacity" Value="0.7" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="PlayerSliderStyle" TargetType="{x:Type Slider}">
        <Setter Property="behaviors:SliderPopupFollowMouseBehavior.Enabled" Value="true" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Template" Value="{StaticResource PlayerSliderHorizontal}" />
    </Style>

    <!--  Volume Slider  -->
    <Style x:Key="VolumeSliderTrackLineStyle" TargetType="{x:Type RepeatButton}">
        <Setter Property="OverridesDefaultStyle" Value="true" />
        <Setter Property="IsTabStop" Value="false" />
        <Setter Property="Focusable" Value="false" />
        <Setter Property="Margin" Value="0" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border
                        Height="{TemplateBinding Height}"
                        Margin="0"
                        VerticalAlignment="{TemplateBinding VerticalAlignment}"
                        Background="{TemplateBinding Background}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="VolumeSliderHorizontal" TargetType="{x:Type Slider}">
        <Grid VerticalAlignment="Center">

            <Border
                x:Name="MaskBorder"
                Height="{TemplateBinding Height}"
                Background="{DynamicResource SliderBackgroundBrush}"
                CornerRadius="8" />

            <Grid>

                <Grid.OpacityMask>
                    <VisualBrush Visual="{Binding ElementName=MaskBorder}" />
                </Grid.OpacityMask>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TickBar
                    x:Name="TopTick"
                    Grid.Row="0"
                    Height="{TemplateBinding Height}"
                    Fill="{TemplateBinding Foreground}"
                    Placement="Top"
                    Visibility="Collapsed" />

                <TickBar
                    x:Name="BottomTick"
                    Grid.Row="2"
                    Height="{TemplateBinding Height}"
                    Fill="{TemplateBinding Foreground}"
                    Visibility="Collapsed" />

                <Track x:Name="PART_Track" Grid.Row="1">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton
                            Height="{TemplateBinding Height}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Background="{DynamicResource AccentBrush}"
                            BorderThickness="0"
                            Command="{x:Static Slider.DecreaseLarge}"
                            Style="{StaticResource VolumeSliderTrackLineStyle}" />
                    </Track.DecreaseRepeatButton>

                    <Track.IncreaseRepeatButton>
                        <RepeatButton
                            Height="{TemplateBinding Height}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Background="{DynamicResource SliderBackgroundBrush}"
                            BorderThickness="0"
                            Command="{x:Static Slider.IncreaseLarge}"
                            Style="{StaticResource VolumeSliderTrackLineStyle}" />
                    </Track.IncreaseRepeatButton>

                    <Track.Thumb>
                        <Thumb Width="0" Height="0" />
                    </Track.Thumb>
                </Track>

                <TextBlock
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="White"
                    Text="{Binding Value, RelativeSource={RelativeSource AncestorType=Slider}, StringFormat={}{0:0}}" />

            </Grid>
        </Grid>

        <ControlTemplate.Triggers>
            <Trigger Property="TickPlacement" Value="TopLeft">
                <Setter TargetName="TopTick" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="TickPlacement" Value="BottomRight">
                <Setter TargetName="BottomTick" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="TickPlacement" Value="Both">
                <Setter TargetName="TopTick" Property="Visibility" Value="Visible" />
                <Setter TargetName="BottomTick" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True" />
            <Trigger Property="IsMouseOver" Value="False" />
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="VolumeSliderStyle" TargetType="{x:Type Slider}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Template" Value="{StaticResource VolumeSliderHorizontal}" />
    </Style>

</ResourceDictionary>