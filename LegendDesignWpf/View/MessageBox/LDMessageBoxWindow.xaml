<controls:LDWindow
    x:Class="LegendDesignWpf.View.MessageBox.LDMessageBoxWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:LegendDesignWpf.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:LegendDesignWpf.View.MessageBox"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    MinWidth="280"
    MinHeight="150"
    ResizeMode="NoResize"
    SizeToContent="WidthAndHeight"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Grid>

        <Grid x:Name="MessageGrid">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>

            <TextBlock
                Margin="20,10"
                FontSize="14"
                Foreground="{DynamicResource ForegroundBrush}"
                Text="{Binding Message, RelativeSource={RelativeSource AncestorType=local:LDMessageBoxWindow}}"
                TextWrapping="Wrap" />

            <ItemsControl
                Grid.Row="1"
                Margin="0,0,15,15"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                ItemsSource="{Binding Buttons, RelativeSource={RelativeSource AncestorType=local:LDMessageBoxWindow}}">

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <controls:FlatButton
                            Height="25"
                            Margin="10,0,0,0"
                            Command="{Binding ButtonClickCommand, RelativeSource={RelativeSource AncestorType=controls:LDWindow}}"
                            CommandParameter="{Binding}"
                            FontSize="13">
                            <TextBlock Margin="10,0,10,0" Text="{Binding Title}" />
                        </controls:FlatButton>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>

            </ItemsControl>

        </Grid>

        <Grid
            x:Name="LoadingGrid"
            Margin="25,0,25,15"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="Collapsed">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <ProgressBar IsIndeterminate="True" Style="{StaticResource CircularProgressBarStyle}" />
            <TextBlock
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                FontSize="14"
                Foreground="{DynamicResource ForegroundBrush}"
                Text="{Binding LoadingMessage, RelativeSource={RelativeSource AncestorType=local:LDMessageBoxWindow}}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="Wrap" />
        </Grid>

    </Grid>

</controls:LDWindow>
